{
  "name": "@iamabdulmoiz/fsm-types",
  "version": "0.1.0",
  "description": "Compile-time state machine enforcement for TypeScript \u2014 invalid transitions are type errors",
  "keywords": [
    "typescript",
    "state-machine",
    "finite-state-machine",
    "type-safety",
    "compile-time",
    "xstate-alternative"
  ],
  "author": "Abdul Moiz",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
